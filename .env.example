# Copie para .env e ajuste. Nunca coloque valores reais neste arquivo.
DATABASE_URL=jdbc:postgresql://localhost:5432/gearhub
DATABASE_USERNAME=gearhub
DATABASE_PASSWORD=gearhub
PORT=8080

# Chaves de 256 bits em base64. Gere com: openssl rand -base64 32
# Guarde em local seguro: sem a chave de AES, os e-mails não podem ser lidos.
GEARHUB_AES_KEY=
GEARHUB_HMAC_KEY=
GEARHUB_ALLOWED_ORIGINS=https://seu-dominio.com

# Login com Google (console.cloud.google.com > Credenciais > ID do cliente OAuth)
# URI de redirecionamento: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEARHUB_SITE_URL=http://localhost:3000
